// Custom node body for M_Background (generated by -run=DIGenerateAssets). Dusk Lagoon theme.
// Inputs: ScreenUV (viewport UV), WP (absolute world position; the ring is centred on the world origin), Time,
//         Fill (ring fullness 0..1), Dark (0/1), Mood (eased fullness 0..1), Bloom (0..1, a chain or a find),
//         Gold (0..1: the bloom is a first-ever number or a new best), Over (0..1, eased game over).
// Output: linear rgb. Drifting water gradient, a soft status glow behind the board, and a glowing ring whose bright
// arc shows how full the ring is.
const float RingRadius = 300.0;

float3 TopDark = float3(0.059, 0.231, 0.298);     // #0F3B4C
float3 BottomDark = float3(0.106, 0.122, 0.290);  // #1B1F4A
float3 TopLight = float3(0.812, 0.937, 0.941);    // #CFEFF0
float3 BottomLight = float3(0.890, 0.902, 0.980); // #E3E6FA
float3 Top = lerp(TopLight, TopDark, Dark);
float3 Bottom = lerp(BottomLight, BottomDark, Dark);

// Slow diagonal drift (~60 s) so the water never feels static.
float Drift = 0.05 * sin(Time * 0.105) + 0.03 * sin(Time * 0.061 + ScreenUV.x * 3.0);
float3 Col = lerp(Top, Bottom, saturate(ScreenUV.y * 0.85 + ScreenUV.x * 0.15 + Drift));

// Board space: X right = world Y, Y up = world X (camera looks down -Z, screen-up = +X).
float2 P = float2(WP.y, WP.x);
float R = length(P);

// Status glow behind the board. Its colour walks a gradient with the eased fullness (calm lagoon -> periwinkle ->
// sun -> coral near full), blooms on chains (gold for a find), and sinks to dusk when the run is over.
const float3 MoodStops[4] = { float3(0.247, 0.722, 0.686), float3(0.549, 0.620, 1.000), float3(1.000, 0.831, 0.502), float3(1.000, 0.608, 0.522) };
const float3 GoldGlow = float3(1.000, 0.831, 0.502);  // #FFD480
const float3 DuskGlow = float3(0.443, 0.353, 0.561);  // #715A8F
const float GlowReach = 1.15;                         // in ring radii
const float GlowDark = 0.2, GlowLight = 0.16;         // strength on each theme: a tint, never a spotlight
const float BloomBoost = 0.9;                         // a full bloom nearly doubles the glow
const float OverDim = 0.55;                           // the dusk glow is this share of the normal one
float Seg = saturate(Mood) * 3.0;
int Si = min((int)Seg, 2);
float3 GlowCol = lerp(MoodStops[Si], MoodStops[Si + 1], smoothstep(0, 1, Seg - Si));
GlowCol = lerp(GlowCol, GoldGlow, saturate(Gold) * saturate(Bloom));
GlowCol = lerp(GlowCol, DuskGlow, saturate(Over));
float Q = R / (RingRadius * GlowReach);
float Halo = exp(-Q * Q * 1.6) * (1 + 0.06 * sin(Time * 0.45)); // breathes very slowly
float GlowAmt = Halo * lerp(GlowLight, GlowDark, Dark) * (1 + BloomBoost * saturate(Bloom)) * lerp(1, OverDim, saturate(Over));
Col = lerp(Col, GlowCol, saturate(GlowAmt));
float AA = max(fwidth(R), 1e-3);
float D = abs(R - RingRadius);
float Line = 1 - smoothstep(1.5 - AA, 1.5 + AA, D);
float Glow = exp(-D * D * 0.02) * 0.18; // faint gaussian sheen hugging the line (~6 units), never a visible band

float Ang = atan2(P.x, P.y);
if (Ang < 0) Ang += 6.2831853;
float A01 = Ang / 6.2831853;
float InArc = 1 - smoothstep(Fill - 0.004, Fill + 0.004, A01);
float GlowArc = (1 - smoothstep(Fill - 0.06, Fill, A01)) * step(0.001, Fill); // glow tapers off before the arc's tip

float3 RingCol = lerp(float3(0.247, 0.663, 0.627), float3(0.373, 0.827, 0.776), Dark); // #3FA9A0 / #5FD3C6
float3 ArcCol = lerp(RingCol, float3(1.000, 0.608, 0.522), saturate((Fill - 0.7) / 0.3)); // -> coral near full
float3 Stroke = lerp(RingCol, ArcCol, InArc);
float Strength = lerp(0.35, 1.0, InArc);
Col = lerp(Col, Stroke, saturate(Line * Strength + Glow * GlowArc * Dark));
return pow(Col, 2.2);
