// Custom node body for M_Background (generated by -run=DIGenerateAssets). Dusk Lagoon theme.
// Inputs: ScreenUV (viewport UV), WP (camera-relative world position), Time, Fill (ring fullness 0..1), Dark (0/1).
// Output: linear rgb. Drifting water gradient + glowing ring whose bright arc shows how full the ring is.
const float RingRadius = 300.0;

float3 TopDark = float3(0.059, 0.231, 0.298);     // #0F3B4C
float3 BottomDark = float3(0.106, 0.122, 0.290);  // #1B1F4A
float3 TopLight = float3(0.812, 0.937, 0.941);    // #CFEFF0
float3 BottomLight = float3(0.890, 0.902, 0.980); // #E3E6FA
float3 Top = lerp(TopLight, TopDark, Dark);
float3 Bottom = lerp(BottomLight, BottomDark, Dark);

// Slow diagonal drift (~60 s) so the water never feels static.
float Drift = 0.05 * sin(Time * 0.105) + 0.03 * sin(Time * 0.061 + ScreenUV.x * 3.0);
float3 Col = lerp(Top, Bottom, saturate(ScreenUV.y * 0.85 + ScreenUV.x * 0.15 + Drift));

// Board space: X right = world Y, Y up = world X (camera looks down -Z, screen-up = +X).
float2 P = float2(WP.y, WP.x);
float R = length(P);
float AA = max(fwidth(R), 1e-3);
float D = abs(R - RingRadius);
float Line = 1 - smoothstep(1.5 - AA, 1.5 + AA, D);
float Glow = exp(-D * 0.06) * 0.35;

float Ang = atan2(P.x, P.y);
if (Ang < 0) Ang += 6.2831853;
float A01 = Ang / 6.2831853;
float InArc = 1 - smoothstep(Fill - 0.004, Fill + 0.004, A01);
float GlowArc = 1 - smoothstep(Fill - 0.04, Fill + 0.01, A01); // glow fades out softly at the arc's tip

float3 RingCol = lerp(float3(0.247, 0.663, 0.627), float3(0.373, 0.827, 0.776), Dark); // #3FA9A0 / #5FD3C6
float3 ArcCol = lerp(RingCol, float3(1.000, 0.608, 0.522), saturate((Fill - 0.7) / 0.3)); // -> coral near full
float3 Stroke = lerp(RingCol, ArcCol, InArc);
float Strength = lerp(0.35, 1.0, InArc);
Col = lerp(Col, Stroke, saturate(Line * Strength + Glow * GlowArc * Dark));
return pow(Col, 2.2);
