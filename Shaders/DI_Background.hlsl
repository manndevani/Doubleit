// Custom node body for M_Background (generated by -run=DIGenerateAssets).
// Inputs: ScreenUV (viewport UV), WP (camera-relative world position), Time, Fill (ring fullness 0..1).
// Output: linear rgb. Soft drifting gradient + thin ring line whose arc shows how full the ring is.
const float RingRadius = 300.0;

float3 Top = float3(0.957, 0.937, 0.914);    // #F4EFE9
float3 Bottom = float3(0.902, 0.871, 0.839); // #E6DED6
float Drift = 0.04 * sin(Time * 0.105);      // ~60 s cycle
float3 Col = lerp(Top, Bottom, saturate(ScreenUV.y + Drift));

// Board space: X right = world Y, Y up = world X (camera looks down -Z, screen-up = +X).
float2 P = float2(WP.y, WP.x);
float R = length(P);
float AA = max(fwidth(R), 1e-3);
float Line = 1 - smoothstep(1.2 - AA, 1.2 + AA, abs(R - RingRadius));

float Ang = atan2(P.x, P.y);
if (Ang < 0) Ang += 6.2831853;
float InArc = step(Ang / 6.2831853, Fill);

float3 LineCol = float3(0.81, 0.776, 0.737);  // #CFC6BC
float3 ArcCol = lerp(float3(0.616, 0.710, 0.627), float3(0.788, 0.561, 0.478), saturate((Fill - 0.7) / 0.3));
Col = lerp(Col, lerp(LineCol, ArcCol, InArc), Line);
return pow(Col, 2.2);
