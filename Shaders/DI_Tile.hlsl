// Custom node body for M_Tile (generated by -run=DIGenerateAssets).
// Inputs: UV, Value, Kind (0 number, 1 plus, 2 minus, 3 breeze), Rank (colour index), Alpha.
// Output: float4(linear rgb, opacity). Everything is procedural: SDF disc + seven-segment digits, no textures.
struct FDITile
{
	float Seg(float2 P, float2 A, float2 B)
	{
		float2 PA = P - A;
		float2 BA = B - A;
		float H = saturate(dot(PA, BA) / dot(BA, BA));
		return length(PA - BA * H);
	}

	// Distance to a seven-segment digit in a 0.5 x 1 box centred on the origin.
	float Digit(float2 P, int D)
	{
		const int Masks[10] = { 0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F };
		int M = Masks[clamp(D, 0, 9)];
		float Dist = 1e5;
		if (M & 1)  Dist = min(Dist, Seg(P, float2(-0.25,  0.5), float2( 0.25,  0.5)));
		if (M & 2)  Dist = min(Dist, Seg(P, float2( 0.25,  0.5), float2( 0.25,  0.0)));
		if (M & 4)  Dist = min(Dist, Seg(P, float2( 0.25,  0.0), float2( 0.25, -0.5)));
		if (M & 8)  Dist = min(Dist, Seg(P, float2(-0.25, -0.5), float2( 0.25, -0.5)));
		if (M & 16) Dist = min(Dist, Seg(P, float2(-0.25,  0.0), float2(-0.25, -0.5)));
		if (M & 32) Dist = min(Dist, Seg(P, float2(-0.25,  0.5), float2(-0.25,  0.0)));
		if (M & 64) Dist = min(Dist, Seg(P, float2(-0.25,  0.0), float2( 0.25,  0.0)));
		return Dist;
	}

	// Signed distance to the rendered number (negative = ink). P in [-1, 1] tile space.
	float Number(float2 P, float V)
	{
		int Count = 1;
		float Div = 1;
		while (Div * 10 <= V && Count < 6)
		{
			Div *= 10;
			Count++;
		}
		float H = min(0.62, 1.3 / (Count * 0.8 - 0.3));
		float X0 = -(Count - 1) * 0.8 * H * 0.5;
		float Rem = V;
		float Dist = 1e5;
		for (int i = 0; i < 6; i++)
		{
			if (i >= Count) break;
			int Dg = (int)floor(Rem / Div + 1e-3);
			Rem -= Dg * Div;
			Div /= 10;
			float2 Q = (P - float2(X0 + i * 0.8 * H, 0)) / H;
			Dist = min(Dist, Digit(Q, Dg) * H);
		}
		return Dist - 0.11 * H;
	}
};

FDITile T;
const float3 Palette[12] =
{
	float3(0.616, 0.710, 0.627), // sage
	float3(0.847, 0.765, 0.647), // sand
	float3(0.788, 0.561, 0.478), // clay
	float3(0.663, 0.612, 0.769), // lavender
	float3(0.561, 0.702, 0.788), // mist
	float3(0.890, 0.710, 0.643), // blush
	float3(0.498, 0.663, 0.608), // teal
	float3(0.788, 0.698, 0.420), // ochre
	float3(0.706, 0.549, 0.651), // mauve
	float3(0.435, 0.561, 0.686), // slate
	float3(0.612, 0.561, 0.478), // taupe
	float3(0.369, 0.490, 0.431)  // deep green
};

// Screen-aligned tile space via the inverse UV Jacobian: glyphs stay upright whatever the mesh's UV layout.
float2 dU = ddx(UV);
float2 dV = ddy(UV);
float Det = dU.x * dV.y - dV.x * dU.y;
float2 C = UV - 0.5;
float2 S = float2(dV.y * C.x - dV.x * C.y, -dU.y * C.x + dU.x * C.y) / Det; // pixels from centre, +y down
float2 P = float2(S.x, -S.y) * length(dU) * 2;
float R = length(P);
float AA = max(fwidth(R), 1e-4);
float Disc = 1 - smoothstep(0.92 - AA, 0.92 + AA, R);
int K = (int)round(Kind);

float3 Fill;
float Sd = 1e5;
if (K == 1)
{
	Fill = float3(0.910, 0.659, 0.486);
	Sd = min(T.Seg(P, float2(-0.4, 0), float2(0.4, 0)), T.Seg(P, float2(0, -0.4), float2(0, 0.4))) - 0.09;
}
else if (K == 2)
{
	Fill = float3(0.522, 0.663, 0.788);
	Sd = T.Seg(P, float2(-0.4, 0), float2(0.4, 0)) - 0.09;
}
else if (K == 3)
{
	Fill = float3(0.980, 0.973, 0.957);
	float Glow = exp(-max(R - 0.92, 0) * 8) * 0.45;
	Disc = max(Disc, Glow * (1 - Disc));
}
else
{
	Fill = Palette[(int)fmod(max(Rank, 0), 12)];
	Sd = T.Number(P, Value);
}

float InkAA = max(fwidth(Sd), 1e-4);
float Ink = 1 - smoothstep(-InkAA, InkAA, Sd);
float Luma = dot(Fill, float3(0.299, 0.587, 0.114));
float3 InkColor = Luma > 0.62 ? float3(0.29, 0.27, 0.25) : float3(0.99, 0.98, 0.96);
float3 Srgb = lerp(Fill, InkColor, Ink);
return float4(pow(Srgb, 2.2), Disc * Alpha);
