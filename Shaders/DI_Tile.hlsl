// Custom node body for M_Tile (generated by -run=DIGenerateAssets).
// Inputs: UV, Value, Kind (0 number, 1 plus, 2 minus, 3 breeze, 4 aim dot, 5 ripple), Rank (colour index), Alpha,
//         Seed (0..1 per piece: pebble outline, sheen and glyph tilt stay with the piece as it moves), Time.
// Output: float4(linear rgb, opacity). Everything is procedural (no textures): sea-glass pebbles with rounded,
// hand-lettered digits. Look: docs/ART_AND_AUDIO.md#tiles-sea-glass-pebbles.
struct FDITile
{
	float Hash(float N)
	{
		return frac(sin(N) * 43758.5453);
	}

	float Hash2(float2 P)
	{
		return frac(sin(dot(P, float2(127.1, 311.7))) * 43758.5453);
	}

	float Seg(float2 P, float2 A, float2 B)
	{
		float2 PA = P - A;
		float2 BA = B - A;
		float H = saturate(dot(PA, BA) / dot(BA, BA));
		return length(PA - BA * H);
	}

	// Distance to the arc of circle (C, R) running counter-clockwise from angle A0 to A1 (radians, A0 < A1).
	float Arc(float2 P, float2 C, float R, float A0, float A1)
	{
		float2 Q = P - C;
		float A = A0 + fmod(atan2(Q.y, Q.x) - A0 + 12.566371, 6.283185);
		if (A <= A1)
		{
			return abs(length(Q) - R);
		}
		return min(length(Q - R * float2(cos(A0), sin(A0))), length(Q - R * float2(cos(A1), sin(A1))));
	}

	float Ring(float2 P, float2 C, float R)
	{
		return abs(length(P - C) - R);
	}

	// Distance to a rounded, hand-lettered digit (centre line) in a 0.5 x 1 box centred on the origin.
	float Digit(float2 P, int D)
	{
		const float Pi = 3.141593;
		if (D == 0) return min(min(Arc(P, float2(0, 0.25), 0.25, 0, Pi), Arc(P, float2(0, -0.25), 0.25, Pi, 2 * Pi)),
			min(Seg(P, float2(-0.25, 0.25), float2(-0.25, -0.25)), Seg(P, float2(0.25, 0.25), float2(0.25, -0.25))));
		if (D == 1) return min(Seg(P, float2(0.05, 0.5), float2(0.05, -0.5)), Seg(P, float2(-0.17, 0.3), float2(0.05, 0.5)));
		if (D == 2) return min(min(Arc(P, float2(0, 0.25), 0.25, -0.7, 2.75), Seg(P, float2(0.191, 0.089), float2(-0.25, -0.5))),
			Seg(P, float2(-0.25, -0.5), float2(0.27, -0.5)));
		if (D == 3) return min(Arc(P, float2(0, 0.25), 0.25, -Pi / 2, 2.6), Arc(P, float2(0, -0.25), 0.25, -2.6, Pi / 2));
		if (D == 4) return min(min(Seg(P, float2(0.12, 0.5), float2(-0.25, -0.2)), Seg(P, float2(-0.25, -0.2), float2(0.28, -0.2))),
			Seg(P, float2(0.12, 0.5), float2(0.12, -0.5)));
		if (D == 5) return min(min(Seg(P, float2(0.24, 0.5), float2(-0.18, 0.5)), Seg(P, float2(-0.18, 0.5), float2(-0.21, 0.04))),
			Arc(P, float2(-0.01, -0.22), 0.27, -2.45, 2.2));
		if (D == 6) return min(Ring(P, float2(0, -0.22), 0.27), Arc(P, float2(0.43, -0.22), 0.7, 1.83, Pi));
		if (D == 7) return min(Seg(P, float2(-0.25, 0.5), float2(0.25, 0.5)), Seg(P, float2(0.25, 0.5), float2(-0.1, -0.5)));
		if (D == 8) return min(Ring(P, float2(0, 0.27), 0.2), Ring(P, float2(0, -0.22), 0.27));
		return min(Ring(-P, float2(0, -0.22), 0.27), Arc(-P, float2(0.43, -0.22), 0.7, 1.83, Pi)); // 9 = 6 turned round
	}

	// Signed distance to the rendered number (negative = ink). P in [-1, 1] tile space.
	float Number(float2 P, float V)
	{
		int Count = 1;
		float Div = 1;
		while (Div * 10 <= V && Count < 6)
		{
			Div *= 10;
			Count++;
		}
		float H = min(0.6, 1.3 / (Count * 0.8 - 0.3));
		float X0 = -(Count - 1) * 0.8 * H * 0.5;
		float Rem = V;
		float Dist = 1e5;
		for (int i = 0; i < 6; i++)
		{
			if (i >= Count) break;
			int Dg = (int)floor(Rem / Div + 1e-3);
			Rem -= Dg * Div;
			Div /= 10;
			float2 Q = (P - float2(X0 + i * 0.8 * H, 0)) / H;
			Dist = min(Dist, Digit(Q, Dg) * H);
		}
		return Dist - 0.1 * H;
	}
};

FDITile T;
// Dusk Lagoon sea-glass palette (sRGB), one colour per ladder rank.
const float3 Palette[12] =
{
	float3(0.498, 0.878, 0.761), // mint      #7FE0C2
	float3(0.357, 0.753, 0.922), // aqua      #5BC0EB
	float3(0.725, 0.651, 0.961), // lilac     #B9A6F5
	float3(1.000, 0.831, 0.502), // sun       #FFD480
	float3(0.969, 0.659, 0.784), // rose      #F7A8C8
	float3(0.620, 0.902, 0.878), // seafoam   #9EE6E0
	float3(0.549, 0.620, 1.000), // periwinkle#8C9EFF
	float3(0.773, 0.910, 0.424), // lime      #C5E86C (no orange tiles: coral is reserved for plus)
	float3(0.247, 0.722, 0.686), // lagoon    #3FB8AF
	float3(0.851, 0.545, 0.878), // orchid    #D98BE0
	float3(0.902, 0.918, 0.949), // pearl     #E6EAF2
	float3(0.180, 0.525, 0.671)  // deep sea  #2E86AB
};

// Screen-aligned tile space via the inverse UV Jacobian: glyphs stay upright whatever the mesh's UV layout.
float2 dU = ddx(UV);
float2 dV = ddy(UV);
float Det = dU.x * dV.y - dV.x * dU.y;
float2 C = UV - 0.5;
float2 S = float2(dV.y * C.x - dV.x * C.y, -dU.y * C.x + dU.x * C.y) / Det; // pixels from centre, +y down
float2 P = float2(S.x, -S.y) * length(dU) * 2;
float R = length(P);
float AA = max(fwidth(R), 1e-4);
int K = (int)round(Kind);

// Pebble outline: a circle bent by three low harmonics, amplitudes and phases from the piece's seed.
// The phases drift slowly (each stone at its own pace) and the stone swells a hair: alive, like a soft blob, never wobbly.
float Theta = atan2(P.y, P.x);
float Pace = 0.6 + 0.8 * T.Hash(Seed * 13.7 + 8.0);
float Bend = (0.03 + 0.025 * T.Hash(Seed * 3.31 + 2.0)) * cos(2 * Theta + 6.283 * T.Hash(Seed * 17.1 + 1.0) + Time * 0.35 * Pace)
	+ (0.015 + 0.02 * T.Hash(Seed * 5.73 + 3.0)) * cos(3 * Theta + 6.283 * T.Hash(Seed * 11.9 + 4.0) - Time * 0.5 * Pace)
	+ 0.01 * T.Hash(Seed * 7.77 + 5.0) * cos(5 * Theta + 6.283 * T.Hash(Seed * 23.3 + 6.0) + Time * 0.7 * Pace);
float Base = (K == 3 ? 0.72 : 0.86) * (1 + 0.015 * sin(Time * 1.05 + Seed * 14.4));
float Rad = Base * (1 + Bend);
float Disc = 1 - smoothstep(Rad - AA, Rad + AA, R);

// Glyphs lean a degree or two, like hand lettering.
float Tilt = (T.Hash(Seed * 9.13 + 7.0) - 0.5) * 0.07;
float2 G = float2(P.x * cos(Tilt) - P.y * sin(Tilt), P.x * sin(Tilt) + P.y * cos(Tilt));

float3 Fill;
float Sd = 1e5;
bool bPebble = K <= 3;
if (K == 1)
{
	Fill = float3(1.000, 0.608, 0.522); // coral #FF9B85
	Sd = min(T.Seg(G, float2(-0.38, 0), float2(0.38, 0)), T.Seg(G, float2(0, -0.38), float2(0, 0.38))) - 0.09;
}
else if (K == 2)
{
	// Inverse of plus: deep-ink stone, coral rim and bar, so it never reads as a number tile.
	Fill = float3(0.110, 0.180, 0.290); // #1C2E4A
	Sd = min(T.Seg(G, float2(-0.38, 0), float2(0.38, 0)) - 0.09, abs(R - Rad * 0.9) - 0.045);
}
else if (K == 3)
{
	Fill = float3(0.949, 0.957, 0.973); // pearl #F2F4F8
	// Smaller stone so the glow fades out inside the quad instead of being clipped square.
	float Glow = exp(-max(R - Rad, 0) * 9) * 0.5 * (1 - smoothstep(0.85, 0.99, R));
	Disc = max(Disc, Glow * (1 - Disc));
	// Three wind lines: the breeze clears the smaller half of the ring.
	float2 Q = G / 0.8;
	Sd = (min(min(T.Seg(Q, float2(-0.4, 0.25), float2(0.25, 0.25)), T.Seg(Q, float2(-0.25, 0), float2(0.4, 0))),
		T.Seg(Q, float2(-0.4, -0.25), float2(0.1, -0.25))) - 0.06) * 0.8;
}
else if (K == 4)
{
	// Aim guide dot: pearl towards a gap, coral towards the tile a minus would lift. Rank 1 = light theme: ink instead of pearl.
	Fill = Value > 0.5 ? float3(1.000, 0.608, 0.522) : (Rank > 0.5 ? float3(0.110, 0.180, 0.290) : float3(0.902, 0.918, 0.949));
	Disc = 1 - smoothstep(0.92 - AA, 0.92 + AA, R);
}
else if (K == 5)
{
	// Impact ripple: a thin ring that the renderer grows and fades. Sun-gold for a first-ever number. Ink on the light theme.
	Fill = Value > 0.5 ? float3(1.000, 0.831, 0.502) : (Rank > 0.5 ? float3(0.110, 0.180, 0.290) : float3(0.902, 0.918, 0.949));
	Disc = 1 - smoothstep(0.035, 0.035 + AA * 1.5, abs(R - 0.86));
}
else
{
	Fill = Palette[(int)fmod(max(Rank, 0), 12)];
	Sd = T.Number(G, Value);
}

float3 Body = Fill;
if (bPebble)
{
	// Sea glass: a soft dome lit from the upper left, a slightly deeper rim, a diffuse sheen and fine frosted grain.
	float U = saturate(R / Rad);
	float Dome = sqrt(1 - U * U);
	float Side = dot(P / max(R, 1e-3) * U, float2(-0.51, 0.86));
	float Rim = 1 - 0.1 * smoothstep(0.7, 1.0, U);
	float2 SheenAt = P - float2(-0.3, 0.36) * Rad;
	float Sheen = exp(-dot(SheenAt, SheenAt) * 16) * 0.16;
	float Grain = (T.Hash2(floor(P * 60) + Seed * 97.0) - 0.5) * 0.035;
	Body = Fill * (0.9 + 0.12 * Dome + 0.05 * Side) * Rim + Sheen + Grain;
}

float InkAA = max(fwidth(Sd), 1e-4);
float Ink = 1 - smoothstep(-InkAA, InkAA, Sd);
float Luma = dot(Fill, float3(0.299, 0.587, 0.114));
float3 InkColor = Luma > 0.62 ? float3(0.063, 0.137, 0.227) : float3(0.97, 0.98, 1.0); // deep ink #10233A / white
if (K == 2) InkColor = float3(1.000, 0.608, 0.522); // coral, matching plus
float3 Srgb = saturate(lerp(Body, InkColor, Ink));
return float4(pow(Srgb, 2.2), Disc * Alpha);
